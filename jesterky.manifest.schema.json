{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunManifest",
  "description": "The full record of a run: enough to replay it and to hand an optimizer a structured process object. Produced by the runner; consumed by the CLI/Stack visualizer, the replay engine, and the optimizers.",
  "type": "object",
  "required": [
    "args",
    "events",
    "recorded",
    "run_id",
    "spec_hash",
    "status",
    "workflow_name"
  ],
  "properties": {
    "args": true,
    "budgets": {
      "description": "Formal resource-budget projection (progress + ETA) when the run declared [`crate::topology::RunPlan::budgets`]. Host-metered; optional for back-compat.",
      "anyOf": [
        {
          "$ref": "#/definitions/BudgetSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoints": {
      "description": "Session state snapshots taken during the run.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Checkpoint"
      }
    },
    "events": {
      "description": "The event stream, in emission order. Sort by `event.addr` for the canonical order (replay compares against that).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Event"
      }
    },
    "goals": {
      "description": "Formal goal / work-product projection when the run declared [`crate::topology::RunPlan::goals`]. Evaluated from the final ledger; optional for back-compat.",
      "anyOf": [
        {
          "$ref": "#/definitions/GoalSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "grounding": {
      "description": "Annotation-grounding projection when the run declared [`crate::topology::RunPlan::grounding`]. SEPARATE from [`Self::status`]: a `completed` run may still report `required_trace_unread` here.",
      "anyOf": [
        {
          "$ref": "#/definitions/GroundingReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "invariants": {
      "description": "Structural self-checks over this manifest (event-addr identity, no orphaned records, per-map fan/gate consistency). Attached when a trace exists. A failing check indicates a runner/manifest bug, not a workload failure.",
      "anyOf": [
        {
          "$ref": "#/definitions/InvariantReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded": {
      "description": "Recorded impure outputs, one per actor/resource invocation.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/RecordedOutput"
      }
    },
    "run_id": {
      "type": "string"
    },
    "spec_hash": {
      "description": "The canonical graph hash this run was produced from (ADR #5). A replay asserts it re-drives the SAME topology.",
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/RunStatus"
    },
    "stop_reason": {
      "description": "Machine-readable terminal reason; consumers should not parse `WorkflowFailed.payload.error`.",
      "default": "completed",
      "allOf": [
        {
          "$ref": "#/definitions/RunStopReason"
        }
      ]
    },
    "trace": {
      "description": "The process tree for optimizer consumption.",
      "anyOf": [
        {
          "$ref": "#/definitions/ProcessNode"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow_name": {
      "type": "string"
    }
  },
  "definitions": {
    "Addr": {
      "description": "The structural address of an event — its identity and its sort key.\n\nField order matters: `derive(Ord)` compares in declaration order, so the effective ordering is `(node_path, iteration, local_seq)` within a run (`run_id` is constant across a run's events). NEVER add an emission counter.",
      "type": "object",
      "required": [
        "iteration",
        "local_seq",
        "node_path",
        "run_id"
      ],
      "properties": {
        "iteration": {
          "description": "Loop/`while` iteration at this node (0 for non-looping nodes).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "local_seq": {
          "description": "Monotonic sequence WITHIN a single `(node_path, iteration)`, allocated locally by the runner. Two parallel siblings never share a `local_seq` because they have distinct `node_path`s.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "node_path": {
          "description": "Where in the execution tree this event was produced.",
          "allOf": [
            {
              "$ref": "#/definitions/NodePath"
            }
          ]
        },
        "run_id": {
          "type": "string"
        }
      }
    },
    "Artifact": {
      "description": "Either an inline small value or a reference to an offloaded one. The runner applies the inline/offload split at a size cap.",
      "anyOf": [
        true,
        {
          "$ref": "#/definitions/ArtifactRef"
        }
      ]
    },
    "ArtifactRef": {
      "description": "A stable reference to an artifact held in the host `ArtifactStore`.",
      "type": "object",
      "required": [
        "content_type",
        "key",
        "size_bytes"
      ],
      "properties": {
        "content_type": {
          "type": "string"
        },
        "key": {
          "description": "e.g. `blob/ab12cd`. Opaque to the core; meaningful to the store.",
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "BudgetCap": {
      "description": "One declared cap on a run.",
      "type": "object",
      "required": [
        "kind",
        "max"
      ],
      "properties": {
        "hard": {
          "description": "When true, exceeding the cap fails the run if [`BudgetPlan::fail_on_hard_exhaust`].",
          "default": false,
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/BudgetKind"
        },
        "label": {
          "description": "Optional display name (panel + snapshot). Defaults to [`BudgetKind::as_str`].",
          "type": [
            "string",
            "null"
          ]
        },
        "max": {
          "description": "Hard ceiling; must be > 0.",
          "type": "number",
          "format": "double"
        },
        "show_eta": {
          "description": "Include this cap on the ETA viz line when a forecast exists (default true).",
          "default": true,
          "type": "boolean"
        },
        "show_progress": {
          "description": "Include this cap on the progress viz line (default true).",
          "default": true,
          "type": "boolean"
        },
        "warning_percent": {
          "description": "Per-cap warning threshold override (percent of cap). Falls back to plan default.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "BudgetEtaConfig": {
      "description": "ETA / burn-rate forecast knobs (host metering + engine).",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Master switch for ETA forecasting (default true).",
          "default": true,
          "type": "boolean"
        },
        "min_wall_secs": {
          "description": "Minimum wall seconds before burn-rate ETA is trusted (default 1.0).",
          "default": 1.0,
          "type": "number",
          "format": "double"
        },
        "mode": {
          "description": "Which ETAs to surface on the panel.",
          "default": "all",
          "allOf": [
            {
              "$ref": "#/definitions/BudgetEtaMode"
            }
          ]
        },
        "sample_interval_secs": {
          "description": "Host sampling cadence hint for live follow (default 0.45s).",
          "default": 0.45,
          "type": "number",
          "format": "double"
        }
      }
    },
    "BudgetEtaMode": {
      "description": "How ETA lines are composed on the terminal panel.",
      "oneOf": [
        {
          "description": "Do not show or compute ETA forecasts.",
          "type": "string",
          "enum": [
            "off"
          ]
        },
        {
          "description": "Show only the soonest-to-exhaust cap.",
          "type": "string",
          "enum": [
            "nearest_only"
          ]
        },
        {
          "description": "Show every cap that has a finite forecast (default).",
          "type": "string",
          "enum": [
            "all"
          ]
        }
      ]
    },
    "BudgetForecast": {
      "description": "ETA to exhaust one budget from observed burn rate.\n\n**Not** “time until the workflow finishes” — see module docs.",
      "type": "object",
      "required": [
        "confidence",
        "model",
        "sample_count"
      ],
      "properties": {
        "confidence": {
          "$ref": "#/definitions/ForecastConfidence"
        },
        "model": {
          "type": "string"
        },
        "rate_per_second": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sample_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "seconds_to_limit": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "seconds_to_limit_high": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "seconds_to_limit_low": {
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "BudgetKind": {
      "description": "What resource is being capped.",
      "oneOf": [
        {
          "description": "Impure actor invocations (model turns, env-coupled hero acts, …).",
          "type": "string",
          "enum": [
            "actor_calls"
          ]
        },
        {
          "description": "Total tokens (in+out) observed on the live bus / recorded usage.",
          "type": "string",
          "enum": [
            "tokens"
          ]
        },
        {
          "description": "Wall-clock seconds since the host started the run.",
          "type": "string",
          "enum": [
            "wall_seconds"
          ]
        }
      ]
    },
    "BudgetPlan": {
      "description": "Full budget configuration for a workflow run (part of [`crate::topology::RunPlan`]).\n\nThis is the **typed JSON interface**: serialize/deserialize as `runplan.budgets`.",
      "type": "object",
      "properties": {
        "caps": {
          "description": "Caps by dimension. Empty plan ⇒ no metering / no panel lines.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/BudgetCap"
          }
        },
        "eta": {
          "description": "ETA forecast configuration.",
          "default": {
            "enabled": true,
            "min_wall_secs": 1.0,
            "mode": "all",
            "sample_interval_secs": 0.45
          },
          "allOf": [
            {
              "$ref": "#/definitions/BudgetEtaConfig"
            }
          ]
        },
        "fail_on_hard_exhaust": {
          "description": "Fail the run when a `hard` cap is exhausted (default true).",
          "default": true,
          "type": "boolean"
        },
        "viz": {
          "description": "Terminal panel configuration.",
          "default": {
            "enabled": true,
            "short_labels": true,
            "show_eta": true,
            "show_nearest_tag": true,
            "show_progress": true
          },
          "allOf": [
            {
              "$ref": "#/definitions/BudgetVizConfig"
            }
          ]
        },
        "warning_percent": {
          "description": "Default warning threshold as percent of cap (0–100). Default 80.",
          "default": 80.0,
          "type": "number",
          "format": "double"
        }
      }
    },
    "BudgetSnapshot": {
      "description": "Full budget projection for a run (live follow + final manifest).",
      "type": "object",
      "required": [
        "items",
        "plan",
        "run_id",
        "schema_version",
        "state",
        "wall_secs"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BudgetStatus"
          }
        },
        "nearest": {
          "description": "Soonest ETA among items that have a finite forecast (when ETA enabled).",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/BudgetStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "description": "Plan knobs used for this projection (echoed for consumers / viz).",
          "allOf": [
            {
              "$ref": "#/definitions/BudgetPlan"
            }
          ]
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "state": {
          "description": "Aggregate run state: exhausted if any hard item is exhausted, else warning, else ok.",
          "allOf": [
            {
              "$ref": "#/definitions/BudgetState"
            }
          ]
        },
        "wall_secs": {
          "description": "Wall seconds used for this snapshot.",
          "type": "number",
          "format": "double"
        }
      }
    },
    "BudgetState": {
      "description": "How close a budget is to its cap.",
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "exhausted",
        "unlimited",
        "unknown"
      ]
    },
    "BudgetStatus": {
      "description": "Progress + forecast for one declared cap.",
      "type": "object",
      "required": [
        "forecast",
        "hard",
        "kind",
        "label",
        "max",
        "remaining",
        "show_eta",
        "show_progress",
        "spent",
        "state",
        "unit",
        "used_percent",
        "utilization"
      ],
      "properties": {
        "forecast": {
          "$ref": "#/definitions/BudgetForecast"
        },
        "hard": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/BudgetKind"
        },
        "label": {
          "description": "Effective display label (from cap or kind).",
          "type": "string"
        },
        "max": {
          "type": "number",
          "format": "double"
        },
        "remaining": {
          "type": "number",
          "format": "double"
        },
        "reserved": {
          "default": 0.0,
          "type": "number",
          "format": "double"
        },
        "show_eta": {
          "type": "boolean"
        },
        "show_progress": {
          "type": "boolean"
        },
        "spent": {
          "type": "number",
          "format": "double"
        },
        "state": {
          "$ref": "#/definitions/BudgetState"
        },
        "unit": {
          "type": "string"
        },
        "used_percent": {
          "description": "Percent of cap used.",
          "type": "number",
          "format": "double"
        },
        "utilization": {
          "description": "`spent / max` in \\[0, ∞); values ≥ 1 mean exhausted.",
          "type": "number",
          "format": "double"
        }
      }
    },
    "BudgetVizConfig": {
      "description": "Terminal / panel rendering knobs for budgets.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Master switch (default true). When false, no budget lines are drawn.",
          "default": true,
          "type": "boolean"
        },
        "short_labels": {
          "description": "Use short labels (`calls`/`tok`/`wall`) instead of full kind names.",
          "default": true,
          "type": "boolean"
        },
        "show_eta": {
          "description": "Show the ETA line (`ETA calls 3m24s · …`).",
          "default": true,
          "type": "boolean"
        },
        "show_nearest_tag": {
          "description": "Append `nearest <kind>` on the ETA line.",
          "default": true,
          "type": "boolean"
        },
        "show_progress": {
          "description": "Show the progress line (`calls 4/64 (6%) · …`).",
          "default": true,
          "type": "boolean"
        }
      }
    },
    "CallKind": {
      "description": "Which impure call produced a [`RecordedOutput`]. Lets a single recorded stream serve both [`crate`]-level actor replay AND resource (env) replay: the `ReplayActor` matches `Actor` entries, the `ReplayResource` matches `ResourceObserve`/`ResourceStep` entries, both keyed by [`Addr`].",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "actor",
            "call"
          ],
          "properties": {
            "actor": {
              "type": "string"
            },
            "call": {
              "type": "string",
              "enum": [
                "actor"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "call",
            "session"
          ],
          "properties": {
            "call": {
              "type": "string",
              "enum": [
                "resource_observe"
              ]
            },
            "session": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "call",
            "session"
          ],
          "properties": {
            "call": {
              "type": "string",
              "enum": [
                "resource_step"
              ]
            },
            "session": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Checkpoint": {
      "description": "A per-session state snapshot (DungeonGrid takes one per turn). `state` may be offloaded to the checkpoint store when large. A `resume_session` node rehydrates from the latest checkpoint for its session.",
      "type": "object",
      "required": [
        "addr",
        "session",
        "state"
      ],
      "properties": {
        "addr": {
          "$ref": "#/definitions/Addr"
        },
        "session": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/Artifact"
        }
      }
    },
    "CitedSpan": {
      "description": "A cited half-open byte range `[start, end)` inside a named source body.",
      "type": "object",
      "required": [
        "end",
        "source",
        "start"
      ],
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "source": {
          "description": "Which source body the span indexes (an [`ArtifactRef::key`], event stream name, or foreign trace id).",
          "type": "string"
        },
        "start": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "Event": {
      "description": "One event in the stream. `wall_ms` is metadata ONLY — never part of ordering or identity (that is [`Addr`]'s job).",
      "type": "object",
      "required": [
        "addr",
        "kind",
        "payload",
        "wall_ms"
      ],
      "properties": {
        "addr": {
          "$ref": "#/definitions/Addr"
        },
        "kind": {
          "$ref": "#/definitions/EventKind"
        },
        "payload": true,
        "wall_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "EventKind": {
      "description": "The closed set of event families. Payload detail rides in [`Event::payload`] as a typed value; this enum is the stable vocabulary consumers switch on. (Taxonomy adapted from `rlm/rlm_event_streaming_plan.md`, retyped — §11.)",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "workflow_started"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "node_started"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "node_completed"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "map_item_started"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "map_item_completed"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "map_item_failed"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "map_completed"
              ]
            }
          }
        },
        {
          "description": "An actor/resource call was recorded (see replay manifest).",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "actor_invoked"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "resource_invoked"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "session_started"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "session_resumed"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "checkpoint_created"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "semaphore_acquired"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "semaphore_released"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "message_published"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "message_available"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "artifact_emitted"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "workflow_completed"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "workflow_failed"
              ]
            }
          }
        }
      ]
    },
    "ForecastConfidence": {
      "description": "Forecast confidence (interval width).",
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "GoalPlan": {
      "description": "Full goal configuration for a workflow run (part of [`crate::topology::RunPlan`]).\n\nThis is the **typed JSON interface**: serialize/deserialize as `runplan.goals`.",
      "type": "object",
      "properties": {
        "cancel_in_flight": {
          "description": "Future control-plane knob: when true, hosts/runners may cancel queued in-flight map work after success wrap-up. Default false preserves v1 entrypoint-skip semantics.",
          "default": false,
          "type": "boolean"
        },
        "fail_on_unmet": {
          "description": "Fail the run when a `required` goal is still unmet at run end. Default true.",
          "default": true,
          "type": "boolean"
        },
        "finalize": {
          "description": "Optional finalize node id to run on success wrap-up. Recorded in v1; runner wiring is a follow-up (see `docs/GOALS.md`).",
          "type": [
            "string",
            "null"
          ]
        },
        "goals": {
          "description": "Declared goals. Empty plan ⇒ no evaluation / no panel line.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/GoalSpec"
          }
        },
        "terminate_on_met": {
          "description": "When every required goal is met, allow the runner to skip remaining entrypoints (early success wrap-up). Default true.",
          "default": true,
          "type": "boolean"
        },
        "viz": {
          "description": "Terminal panel configuration.",
          "default": {
            "enabled": true,
            "short_labels": true,
            "show_progress": true
          },
          "allOf": [
            {
              "$ref": "#/definitions/GoalVizConfig"
            }
          ]
        }
      }
    },
    "GoalSnapshot": {
      "description": "Full goal projection for a run (live follow + final manifest).",
      "type": "object",
      "required": [
        "items",
        "plan",
        "required_met",
        "required_total",
        "run_id",
        "schema_version",
        "state"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GoalStatus"
          }
        },
        "plan": {
          "description": "Plan knobs used for this projection (echoed for consumers / viz).",
          "allOf": [
            {
              "$ref": "#/definitions/GoalPlan"
            }
          ]
        },
        "required_met": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "required_total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "state": {
          "description": "`met` iff every required goal is met; else `unmet`.",
          "allOf": [
            {
              "$ref": "#/definitions/GoalState"
            }
          ]
        },
        "terminated_early": {
          "description": "Set by the host/runner when it stopped remaining work because the goals were met. The pure engine always emits `false`.",
          "default": false,
          "type": "boolean"
        }
      }
    },
    "GoalSpec": {
      "description": "One declared goal on a run.",
      "type": "object",
      "oneOf": [
        {
          "description": "Met when the ledger value at `path` deep-equals `equals`.",
          "type": "object",
          "required": [
            "equals",
            "kind",
            "path"
          ],
          "properties": {
            "equals": true,
            "kind": {
              "type": "string",
              "enum": [
                "ledger_pred"
              ]
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "description": "Met when the numeric ledger value at `path` is `>= min`. Progress = `value/min`.",
          "type": "object",
          "required": [
            "kind",
            "min",
            "path"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "metric_threshold"
              ]
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "path": {
              "type": "string"
            }
          }
        }
      ],
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "Stable identifier (unique within a plan).",
          "type": "string"
        },
        "label": {
          "description": "Optional display name (panel + snapshot). Defaults to [`Self::id`].",
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "description": "Required goals gate the run state and `fail_on_unmet` (default true). Non-required goals record progress only and never block.",
          "default": true,
          "type": "boolean"
        },
        "show_progress": {
          "description": "Include this goal on the progress viz line (default true).",
          "default": true,
          "type": "boolean"
        }
      }
    },
    "GoalState": {
      "description": "Whether a goal (or the whole run) is satisfied.",
      "oneOf": [
        {
          "description": "Predicate satisfied.",
          "type": "string",
          "enum": [
            "met"
          ]
        },
        {
          "description": "Predicate evaluated but not satisfied.",
          "type": "string",
          "enum": [
            "unmet"
          ]
        },
        {
          "description": "Path missing or wrong type — cannot evaluate.",
          "type": "string",
          "enum": [
            "unknown"
          ]
        }
      ]
    },
    "GoalStatus": {
      "description": "Result of evaluating one goal against the ledger.",
      "type": "object",
      "required": [
        "detail",
        "id",
        "kind",
        "label",
        "progress",
        "required",
        "show_progress",
        "state"
      ],
      "properties": {
        "detail": {
          "description": "Human-readable evaluation (`summary.score 0.72 < min 0.80`).",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "`ledger_pred` / `metric_threshold`.",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "observed": {
          "description": "The observed ledger value at the goal's path (echoed for consumers)."
        },
        "progress": {
          "description": "Partial credit in `[0, 1]`: `1.0` when met, `value/min` for a threshold, `0.0` for an unmet predicate, `0.0` when unknown.",
          "type": "number",
          "format": "double"
        },
        "required": {
          "type": "boolean"
        },
        "show_progress": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/definitions/GoalState"
        }
      }
    },
    "GoalVizConfig": {
      "description": "Terminal / panel rendering knobs for goals.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Master switch (default true). When false, no goal line is drawn.",
          "default": true,
          "type": "boolean"
        },
        "short_labels": {
          "description": "Use short labels (goal id) instead of the full label.",
          "default": true,
          "type": "boolean"
        },
        "show_progress": {
          "description": "Show the per-goal progress line (`goals 1/2 met · quality 0.72/0.80`).",
          "default": true,
          "type": "boolean"
        }
      }
    },
    "Grounding": {
      "description": "Per-output grounding state. Internally tagged (`\"state\": \"...\"`).\n\nThe `Default` — and therefore the serde default for legacy rows that predate this field — is `Ungraded`: absent grounding data NEVER reads as grounded.",
      "oneOf": [
        {
          "description": "No grounding audit graded this output (the explicit legacy reading).",
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "ungraded"
              ]
            }
          }
        },
        {
          "description": "A grounding audit graded this output; the record carries the evidence.",
          "type": "object",
          "required": [
            "annotator",
            "confidence",
            "schema_version",
            "state",
            "trace_body_read",
            "verdict"
          ],
          "properties": {
            "annotator": {
              "description": "Annotator identity — a model route (e.g. `openai/gpt-5.5`) or a human handle.",
              "type": "string"
            },
            "cited_event_ids": {
              "description": "Event ids in the source material the annotation cites.",
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cited_spans": {
              "description": "Byte spans in the source material the annotation cites.",
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/CitedSpan"
              }
            },
            "confidence": {
              "description": "Annotator confidence in `[0, 1]`.",
              "type": "number",
              "format": "double"
            },
            "review_state": {
              "default": "unreviewed",
              "allOf": [
                {
                  "$ref": "#/definitions/ReviewState"
                }
              ]
            },
            "schema_version": {
              "description": "[`GROUNDING_SCHEMA_VERSION`] at grading time.",
              "type": "string"
            },
            "sources": {
              "description": "Immutable source refs (run/artifact identity). Empty when the corpus carried no identity — which itself is evidence the row cannot be re-verified.",
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/GroundingSourceRef"
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "graded"
              ]
            },
            "trace_body_read": {
              "description": "TRUE only when the annotator read the trace BODY. A `grounded` verdict with `trace_body_read: false` is contradictory and is counted as unread by [`GroundingReport::compute`].",
              "type": "boolean"
            },
            "verdict": {
              "$ref": "#/definitions/GroundingVerdict"
            }
          }
        }
      ]
    },
    "GroundingReport": {
      "description": "The run-level grounding projection, attached to [`crate::artifact::RunManifest::grounding`]. A PURE function of the recorded rows + the declared plan; computing it never changes the run's terminal status.",
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "tally",
        "trace_required"
      ],
      "properties": {
        "schema_version": {
          "description": "[`GROUNDING_SCHEMA_VERSION`] at compute time.",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/GroundingStatus"
        },
        "tally": {
          "$ref": "#/definitions/GroundingTally"
        },
        "trace_required": {
          "description": "Echo of [`GroundingPlan::trace_required`] the report was computed under.",
          "type": "boolean"
        }
      }
    },
    "GroundingSourceRef": {
      "description": "Immutable identity of source material a verdict was graded against. Internally tagged (`\"source\": \"...\"`) so refs stay flat JSON objects.",
      "oneOf": [
        {
          "description": "A jesterky/SMR run identity.",
          "type": "object",
          "required": [
            "run_id",
            "source"
          ],
          "properties": {
            "run_id": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "run"
              ]
            }
          }
        },
        {
          "description": "An immutable artifact in the host store.",
          "type": "object",
          "required": [
            "artifact",
            "source"
          ],
          "properties": {
            "artifact": {
              "$ref": "#/definitions/ArtifactRef"
            },
            "source": {
              "type": "string",
              "enum": [
                "artifact"
              ]
            }
          }
        },
        {
          "description": "A foreign system's record (e.g. a GameBench capture): system + stable id.",
          "type": "object",
          "required": [
            "id",
            "source",
            "system"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "external"
              ]
            },
            "system": {
              "type": "string"
            }
          }
        }
      ]
    },
    "GroundingStatus": {
      "description": "Run-level grounding status. SEPARATE from — and never derived from — [`crate::artifact::RunStatus`]: a `Completed` run may carry any of these.",
      "oneOf": [
        {
          "description": "Every recorded output is graded `grounded` from a read trace body.",
          "type": "string",
          "enum": [
            "grounded"
          ]
        },
        {
          "description": "At least one graded output carries a non-grounded verdict (or a row is still ungraded) in a workflow that does not require traces.",
          "type": "string",
          "enum": [
            "degraded"
          ]
        },
        {
          "description": "The typed failure for trace-REQUIRED workflows: at least one output's trace body was never read (ungraded, summary-only, unread, unreadable, or access-failed).",
          "type": "string",
          "enum": [
            "required_trace_unread"
          ]
        },
        {
          "description": "No outputs are graded (legacy manifests, or grading has not run).",
          "type": "string",
          "enum": [
            "ungraded"
          ]
        }
      ]
    },
    "GroundingTally": {
      "description": "Per-verdict row counts over a manifest's recorded outputs.",
      "type": "object",
      "required": [
        "grounded",
        "source_unread",
        "source_unreadable",
        "summary_only",
        "trace_access_failed",
        "ungraded"
      ],
      "properties": {
        "grounded": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "source_unread": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "source_unreadable": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "summary_only": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "trace_access_failed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "ungraded": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "GroundingVerdict": {
      "description": "Evidence quality of one graded output. Closed set; adding a member is a contract change (mirrors the [`crate::budget::BudgetKind`] discipline).\n\nNote there is deliberately no `Ungraded` member here: \"nobody graded this row\" is the [`Grounding::Ungraded`] state, not a verdict an annotator may assert.",
      "oneOf": [
        {
          "description": "The annotation was produced from the READ trace body and cites it.",
          "type": "string",
          "enum": [
            "grounded"
          ]
        },
        {
          "description": "The annotation was produced from a summary/count projection only.",
          "type": "string",
          "enum": [
            "summary_only"
          ]
        },
        {
          "description": "A source exists and is readable, but the annotator never opened it.",
          "type": "string",
          "enum": [
            "source_unread"
          ]
        },
        {
          "description": "The source body exists but could not be parsed/decoded.",
          "type": "string",
          "enum": [
            "source_unreadable"
          ]
        },
        {
          "description": "Fetching the trace failed (GC'd snapshot, auth, transport).",
          "type": "string",
          "enum": [
            "trace_access_failed"
          ]
        }
      ]
    },
    "InvariantCheck": {
      "description": "One structural invariant checked over a finished [`RunManifest`].",
      "type": "object",
      "required": [
        "detail",
        "name",
        "ok"
      ],
      "properties": {
        "detail": {
          "description": "Human-readable evidence (counts, the offending addr, …).",
          "type": "string"
        },
        "name": {
          "description": "Stable check id (e.g. `unique_event_addrs`, `map:scan_jobs.over_matches_total`).",
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      }
    },
    "InvariantReport": {
      "description": "The manifest self-check report. `all_ok` is the AND of every check.",
      "type": "object",
      "required": [
        "all_ok",
        "checks"
      ],
      "properties": {
        "all_ok": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvariantCheck"
          }
        }
      }
    },
    "NodePath": {
      "description": "Fully-qualified position of a node in a run's dynamic execution tree. Ordering is lexicographic over segments (derived), which is exactly the structural order we want.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PathSeg"
      }
    },
    "PathSeg": {
      "description": "One segment of a node path. A path alternates named nodes and numeric indices, e.g. `audit_jobs` → `[3]` for the 4th map item. Kept typed (not a string) so that `Index(2) < Index(10)` orders numerically, not lexically.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "node"
          ],
          "properties": {
            "node": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "index"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ProcessNode": {
      "description": "One node's contribution to the process tree.",
      "type": "object",
      "required": [
        "addr",
        "artifacts",
        "children",
        "inputs",
        "label",
        "outputs"
      ],
      "properties": {
        "addr": {
          "$ref": "#/definitions/Addr"
        },
        "artifacts": {
          "description": "Large outputs offloaded to the store.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactRef"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProcessNode"
          }
        },
        "inputs": {
          "description": "Typed inputs the node received (post-binding-resolution)."
        },
        "label": {
          "description": "e.g. \"map:audit_jobs\", \"actor:quality_auditor\".",
          "type": "string"
        },
        "outputs": {
          "description": "Typed outputs the node produced."
        },
        "score": {
          "description": "Optimizer slot: an outcome score, if the actor supplied one. Grades OUTCOMES only.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "signal": {
          "description": "Optimizer slot: a wall-safe verifier signal, if any."
        }
      }
    },
    "RecordedOutput": {
      "description": "What an actor/resource returned, recorded so replay can re-drive without the live model/env (ADR #7). Keyed by [`Addr`] via the `addr` field (kept in a `Vec` rather than a map so the manifest serializes to plain JSON).",
      "type": "object",
      "required": [
        "addr",
        "artifacts",
        "call",
        "outputs"
      ],
      "properties": {
        "addr": {
          "$ref": "#/definitions/Addr"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactRef"
          }
        },
        "call": {
          "$ref": "#/definitions/CallKind"
        },
        "grounding": {
          "description": "Evidence-quality verdict for this output, SEPARATE from run lifecycle (see [`crate::grounding`]). Missing on legacy rows deserializes to [`crate::grounding::Grounding::Ungraded`] — never to grounded.",
          "default": {
            "state": "ungraded"
          },
          "allOf": [
            {
              "$ref": "#/definitions/Grounding"
            }
          ]
        },
        "outputs": true,
        "score": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "signal": true
      }
    },
    "ReviewState": {
      "description": "Reviewer state of a graded verdict (human/second-pass audit trail).",
      "type": "string",
      "enum": [
        "unreviewed",
        "reviewed",
        "disputed"
      ]
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "completed",
        "failed"
      ]
    },
    "RunStopReason": {
      "type": "string",
      "enum": [
        "completed",
        "node_failed",
        "goal_unmet",
        "budget_exhausted"
      ]
    }
  }
}