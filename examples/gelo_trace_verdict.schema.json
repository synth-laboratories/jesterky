{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "optimizer",
    "exploration_themes",
    "underexplored_actions",
    "behavioral_diversity_score",
    "reward",
    "achievement_count",
    "theme_tags",
    "severity",
    "blocker"
  ],
  "properties": {
    "trace_id": { "type": "string" },
    "optimizer": { "type": "string", "enum": ["gelo"] },
    "exploration_themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme", "saturation", "evidence"],
        "properties": {
          "theme": { "type": "string" },
          "saturation": { "type": "number" },
          "evidence": { "type": "string" }
        }
      }
    },
    "underexplored_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "behavioral_diversity_score": { "type": "number" },
    "reward": { "type": "number" },
    "achievement_count": { "type": "integer" },
    "theme_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "severity": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "critical"]
    },
    "blocker": { "type": "boolean" }
  }
}
