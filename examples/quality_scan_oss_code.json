{
  "name": "quality_scan_oss_code",
  "entrypoint": [
    "expand_modules",
    "audit_modules",
    "aggregate"
  ],
  "nodes": {
    "expand_modules": {
      "kind": "program",
      "op": "oss_code.expand",
      "inputs": {},
      "outputs": {
        "jobs": "ledger.jobs"
      }
    },
    "audit_modules": {
      "kind": "map",
      "over": "ledger.jobs",
      "item_as": "module",
      "concurrency": 8,
      "min_success": 0.0,
      "body": {
        "kind": "actor",
        "actor": "oss_code_auditor",
        "inputs": {
          "module": "module"
        },
        "outputs": {}
      },
      "outputs": {
        "audit": "ledger.audits"
      }
    },
    "aggregate": {
      "kind": "reduce",
      "op": "oss_code.aggregate",
      "inputs": {
        "jobs": "ledger.jobs",
        "audits": "ledger.audits"
      },
      "outputs": {
        "summary": "ledger.summary"
      }
    }
  },
  "runplan": {
    "map_concurrency": 8
  }
}
